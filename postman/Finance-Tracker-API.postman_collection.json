{
  "info": {
    "_postman_id": "a1b2c3d4-finance-tracker-api",
    "name": "Finance Tracker API",
    "description": "Personal Finance Tracker REST API (Spring Boot)\n\n**Setup**\n1. Import this collection + `Finance-Tracker-Local.postman_environment.json`\n2. Select environment: **Finance Tracker - Local**\n3. Run **Register** then **Login** (saves tokens automatically)\n4. Run other requests in order\n\nBase URL: {{baseUrl}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection uses environment variables: baseUrl, accessToken, etc."
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "categoryId", "value": "1" },
    { "key": "transactionId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "filename", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "description": "No Bearer token required for these requests.",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin1@gmail.com\",\n  \"password\": \"admin@123\",\n  \"fullName\": \"Admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "POST /api/auth/register — 201 on success, 409 if email exists"
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "  pm.environment.set('accessToken', res.data.accessToken);",
                  "  pm.environment.set('refreshToken', res.data.refreshToken);",
                  "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "  console.log('Tokens saved to environment');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin1@gmail.com\",\n  \"password\": \"admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "POST /api/auth/login — saves accessToken & refreshToken automatically"
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "  pm.environment.set('accessToken', res.data.accessToken);",
                  "  pm.environment.set('refreshToken', res.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Categories",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          },
          "response": []
        },
        {
          "name": "Create Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.id) {",
                  "  pm.environment.set('categoryId', res.data.id);",
                  "  pm.collectionVariables.set('categoryId', res.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Food\",\n  \"type\": \"EXPENSE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          },
          "response": []
        },
        {
          "name": "Create Category (Income - Salary)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Salary\",\n  \"type\": \"INCOME\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          },
          "response": []
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Groceries\",\n  \"type\": \"EXPENSE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories", "{{categoryId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories", "{{categoryId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Transactions",
      "item": [
        {
          "name": "List All Transactions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"]
            }
          },
          "response": []
        },
        {
          "name": "List Transactions (filtered)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transactions?type=EXPENSE&month=2025-05&categoryId={{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"],
              "query": [
                { "key": "type", "value": "EXPENSE", "description": "INCOME | EXPENSE" },
                { "key": "month", "value": "2026-05", "description": "yyyy-MM" },
                { "key": "categoryId", "value": "{{categoryId}}" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Transaction",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.id) {",
                  "  pm.environment.set('transactionId', res.data.id);",
                  "  pm.collectionVariables.set('transactionId', res.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50.00,\n  \"note\": \"lunch\",\n  \"type\": \"EXPENSE\",\n  \"date\": \"2025-05-10\",\n  \"categoryId\": {{categoryId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"]
            }
          },
          "response": []
        },
        {
          "name": "Update Transaction",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 55.00,\n  \"note\": \"lunch updated\",\n  \"type\": \"EXPENSE\",\n  \"date\": \"2025-05-10\",\n  \"categoryId\": {{categoryId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "{{transactionId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Transaction",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "{{transactionId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Upload Receipt",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.path) {",
                  "  const path = res.data.path;",
                  "  const parts = path.replace('uploads/', '').split('/');",
                  "  if (parts.length >= 2) {",
                  "    pm.environment.set('userId', parts[0]);",
                  "    pm.environment.set('filename', parts[1]);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "jpg, jpeg, png, pdf — max 5MB",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transactionId}}/receipt",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "{{transactionId}}", "receipt"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - Reports",
      "item": [
        {
          "name": "Monthly Summary",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/reports/monthly?month=2025-05",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "monthly"],
              "query": [
                { "key": "month", "value": "2026-05", "description": "yyyy-MM" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Category Breakdown",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/reports/categories?month=2025-05",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "categories"],
              "query": [
                { "key": "month", "value": "2026-05", "description": "yyyy-MM" }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "05 - Files",
      "item": [
        {
          "name": "Get Receipt File",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/files/{{userId}}/{{filename}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "{{userId}}", "{{filename}}"]
            },
            "description": "Set userId and filename from upload response path"
          },
          "response": []
        }
      ]
    }
  ]
}
